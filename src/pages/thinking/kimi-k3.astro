---
const description = 'Kimi K3 技术报告的零基础完整导读：从 token、注意力、MoE 讲到架构、训练、基础设施、评测与案例。';
const canonicalUrl = 'https://zuoxiqiu.com/thinking/kimi-k3/';
const pageTitle = 'Kimi K3 技术报告｜从零开始的完整导读';
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: pageTitle,
  description,
  datePublished: '2026-07-29T00:00:00.000+08:00',
  author: { '@type': 'Person', name: '昨夕秋' },
  mainEntityOfPage: canonicalUrl,
  about: ['Kimi K3', 'Mixture of Experts', 'Attention', 'Large language models'],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow">
  <meta name="generator" content={Astro.generator}>
  <meta name="theme-color" content="#eee3cf">
  <meta property="og:type" content="article">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content="zh_CN">
  <meta property="article:published_time" content="2026-07-29T00:00:00.000+08:00">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={description}>
  <link rel="canonical" href={canonicalUrl}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <title>{pageTitle}</title>
  <script type="application/ld+json" set:html={structuredData}></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#f5f1e8;--paper:#fffdf8;--ink:#1f2725;--muted:#65716c;--line:#dcd7cb;
      --green:#0f6b55;--green2:#dceee7;--gold:#a36b19;--gold2:#f5e8c9;
      --red:#9a3f35;--red2:#f7e3df;--blue:#315f85;--blue2:#e1edf6;
      --code:#182321;--shadow:0 18px 55px rgba(41,48,44,.10);
      --content:780px;--side:250px;--font-size:18px;
    }
    [data-theme="dark"]{
      --bg:#111715;--paper:#18201d;--ink:#edf2ef;--muted:#aab8b2;--line:#34413c;
      --green:#66d2ae;--green2:#203d34;--gold:#edbd6b;--gold2:#41341f;
      --red:#f09c90;--red2:#442924;--blue:#8bc4ef;--blue2:#203746;
      --code:#0c1210;--shadow:none;
    }
    *{box-sizing:border-box}
    .sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
    html{scroll-behavior:smooth;scroll-padding-top:34px}
    body{margin:0;background:var(--bg);color:var(--ink);font:var(--font-size)/1.82 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif}
    a{color:var(--green);text-decoration-thickness:1px;text-underline-offset:3px}
    button{font:inherit}
    #progress{position:fixed;z-index:50;top:0;left:0;height:4px;width:0;background:linear-gradient(90deg,var(--green),#d29a3d)}
    .layout{display:grid;grid-template-columns:var(--side) minmax(0,var(--content));gap:58px;max-width:1180px;margin:auto;padding:28px 30px 100px}
    aside{position:sticky;top:26px;height:calc(100vh - 52px);overflow:auto;padding:18px 4px}
    .brand{font-weight:800;letter-spacing:.05em;font-size:15px;margin-bottom:18px}
    .brand small{display:block;color:var(--muted);font-weight:500;letter-spacing:0;margin-top:4px}
    nav a{display:block;padding:6px 10px;margin:1px 0;border-left:2px solid transparent;color:var(--muted);text-decoration:none;font-size:14px;line-height:1.35}
    nav a:hover,nav a.active{color:var(--green);border-color:var(--green);background:var(--green2)}
    .tools{display:flex;gap:8px;margin:18px 8px;flex-wrap:wrap}
    .tools button{border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:999px;padding:5px 10px;cursor:pointer;font-size:13px}
    main{min-width:0}
    .hero{background:var(--paper);border:1px solid var(--line);box-shadow:var(--shadow);padding:54px 54px 42px;margin-top:12px;position:relative;overflow:hidden}
    .hero:before{content:"";position:absolute;right:-90px;top:-90px;width:260px;height:260px;border:42px solid var(--green2);border-radius:50%}
    .eyebrow{color:var(--green);font-weight:800;letter-spacing:.12em;font-size:13px;text-transform:uppercase}
    h1{font:800 clamp(38px,6vw,70px)/1.08 Georgia,"Songti SC","STSong",serif;letter-spacing:-.035em;margin:18px 0 18px;max-width:680px}
    .deck{font-size:21px;line-height:1.65;color:var(--muted);max-width:650px}
    .meta{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:28px;color:var(--muted);font-size:14px}
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0 42px}
    .stat{background:var(--paper);border:1px solid var(--line);padding:18px}
    .stat b{font:700 27px/1.1 Georgia,serif;color:var(--green);display:block}
    .stat span{color:var(--muted);font-size:13px}
    article>section{margin:70px 0}
    h2{font:800 38px/1.22 Georgia,"Songti SC","STSong",serif;margin:0 0 24px;padding-top:8px}
    h3{font-size:25px;line-height:1.35;margin:42px 0 15px}
    h4{font-size:19px;margin:30px 0 10px}
    p{margin:11px 0}
    ul,ol{padding-left:1.35em}
    li{margin:8px 0}
    .lead{font-size:21px;line-height:1.75;color:var(--muted)}
    .card,.note,.truth,.explain,.caution{border:1px solid var(--line);background:var(--paper);padding:22px 24px;margin:22px 0}
    .note{border-left:5px solid var(--blue);background:var(--blue2)}
    .truth{border-left:5px solid var(--green);background:var(--green2)}
    .explain{border-left:5px solid var(--gold);background:var(--gold2)}
    .caution{border-left:5px solid var(--red);background:var(--red2)}
    .label{display:block;font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:800;margin-bottom:7px}
    .truth .label{color:var(--green)}.explain .label{color:var(--gold)}.caution .label{color:var(--red)}.note .label{color:var(--blue)}
    .grid2,.grid3{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:22px 0}
    .grid3{grid-template-columns:repeat(3,minmax(0,1fr))}
    .mini{border:1px solid var(--line);background:var(--paper);padding:18px}
    .mini h4{margin:0 0 7px}
    .flow{display:flex;gap:8px;align-items:stretch;flex-wrap:wrap;margin:22px 0}
    .flow .step{flex:1 1 120px;background:var(--paper);border:1px solid var(--line);padding:14px;position:relative}
    .flow .step:not(:last-child):after{content:"→";position:absolute;right:-9px;top:50%;transform:translateY(-50%);color:var(--green);font-weight:900;z-index:2}
    .formula{background:var(--code);color:#eef8f3;padding:18px 20px;overflow:auto;border-radius:4px;font:15px/1.65 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;margin:18px 0}
    code{background:color-mix(in srgb,var(--green2) 70%,transparent);padding:.08em .35em;border-radius:3px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.88em}
    abbr{text-decoration:underline dotted;color:var(--green);cursor:help;text-underline-offset:3px}
    details{border:1px solid var(--line);background:var(--paper);margin:16px 0}
    summary{cursor:pointer;font-weight:750;padding:15px 18px}
    details>div{padding:0 20px 18px}
    .table-wrap{overflow:auto;border:1px solid var(--line);margin:22px 0;background:var(--paper)}
    table{width:100%;border-collapse:collapse;font-size:14px;white-space:nowrap}
    th,td{border-bottom:1px solid var(--line);padding:10px 12px;text-align:right}
    th:first-child,td:first-child{text-align:left;position:sticky;left:0;background:var(--paper)}
    thead th{background:var(--green2);color:var(--ink);font-weight:800}
    .compact td,.compact th{padding:7px 10px}
    .rank{display:grid;grid-template-columns:140px 1fr;gap:12px;align-items:center;margin:10px 0}
    .bar{height:10px;background:var(--line);overflow:hidden;border-radius:10px}.bar i{display:block;height:100%;background:var(--green)}
    .term{display:grid;grid-template-columns:150px 1fr;gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
    .term dt{font-weight:800;color:var(--green)}.term dd{margin:0}
    .quote{font:600 25px/1.55 Georgia,"Songti SC",serif;border-left:5px solid var(--green);padding-left:22px;margin:35px 0}
    .small{font-size:14px;color:var(--muted)}
    .source-list{font-size:15px;color:var(--muted)}
    footer{border-top:1px solid var(--line);padding-top:28px;margin-top:70px;color:var(--muted);font-size:14px}
    .mobile-nav{display:none}
    @media(max-width:960px){
      .layout{display:block;padding:14px 18px 70px}aside{display:none}.mobile-nav{display:block;position:sticky;top:8px;z-index:30;margin:8px 0}
      .mobile-nav details{box-shadow:var(--shadow)}.mobile-nav nav{padding:0 12px 12px;max-height:65vh;overflow:auto}
      .hero{padding:38px 26px}.stats{grid-template-columns:repeat(2,1fr)}.grid3{grid-template-columns:1fr}
    }
    @media(max-width:620px){
      :root{--font-size:17px}.grid2{grid-template-columns:1fr}.hero{padding:30px 21px}.stats{grid-template-columns:1fr 1fr}
      h2{font-size:31px}.flow .step:not(:last-child):after{display:none}.term{grid-template-columns:1fr}
    }
    @media print{
      #progress,aside,.mobile-nav,.tools{display:none!important}.layout{display:block;max-width:800px;padding:0}.hero,.card,.mini{box-shadow:none}
      details>div{display:block!important}body{background:#fff;color:#111}article>section{break-inside:auto}
    }

    /* Zuoxiqiu editorial skin: continuous reading first, relationships second. */
    :root{
      --page:#f5f2eb;--paper:#faf8f4;--paper-soft:#eee8de;--ink:#181411;
      --muted:#5d5750;--soft:#8c857b;--line:rgba(24,20,17,.13);
      --line-strong:rgba(24,20,17,.2);--clay:#b85c36;--clay-soft:#f2e4dc;
      --forest:#315f55;--forest-soft:#e4ebe7;--gold:#ae7f35;--gold-soft:#f4ecd8;
      --blue:#376887;--blue-soft:#e5edf2;--violet:#775f8e;--violet-soft:#ece7f0;
      --serif:"思源宋体 VF","Source Han Serif SC VF","Source Han Serif SC","Noto Serif SC","Songti SC","STSong",serif;
      --mono:"SFMono-Regular","SF Mono","Menlo","Monaco",monospace;
      --font-size:18px;--side:0px;--content:940px;
    }
    [data-theme="dark"]{
      --page:#15130f;--paper:#201d18;--paper-soft:#2a251e;--ink:#f0eadf;
      --muted:#b9aea0;--soft:#90877e;--line:rgba(240,234,223,.13);
      --line-strong:rgba(240,234,223,.24);--clay:#e18a66;--clay-soft:#422b23;
      --forest:#89b7aa;--forest-soft:#243b35;--gold:#e1bc71;--gold-soft:#3c3220;
      --blue:#8fbed8;--blue-soft:#243740;--violet:#bba5d0;--violet-soft:#352c3e;
      --bg:var(--page);--green:var(--forest);--green2:var(--forest-soft);--red:var(--clay);--red2:var(--clay-soft);
      --code:#0f1210;
    }
    html{scroll-padding-top:86px}
    body{
      background:
        radial-gradient(circle at 7% 4%,color-mix(in srgb,var(--gold) 12%,transparent),transparent 28rem),
        radial-gradient(circle at 93% 25%,color-mix(in srgb,var(--forest) 11%,transparent),transparent 34rem),
        var(--page);
      color:var(--ink);font-family:var(--serif);line-height:1.92;text-rendering:optimizeLegibility;
      -webkit-font-smoothing:antialiased;
    }
    body::before,body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:-1}
    body::before{
      background:
        linear-gradient(color-mix(in srgb,var(--ink) 3%,transparent) 1px,transparent 1px),
        linear-gradient(90deg,color-mix(in srgb,var(--ink) 3%,transparent) 1px,transparent 1px);
      background-size:120px 120px;mask-image:linear-gradient(to bottom,#000,transparent 82%);opacity:.25;
    }
    body::after{
      background-image:radial-gradient(color-mix(in srgb,var(--ink) 10%,transparent) .7px,transparent .7px);
      background-size:36px 36px;opacity:.12;
    }
    .layout{display:block;width:min(940px,calc(100% - 34px));max-width:none;margin:0 auto;padding:0 0 72px}
    aside{
      position:sticky;z-index:45;top:0;width:100%;height:auto;display:grid;
      grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:18px;
      padding:13px 18px;border-bottom:1px solid var(--line);overflow:visible;
      background:color-mix(in srgb,var(--paper) 88%,transparent);backdrop-filter:blur(18px);
    }
    .brand{margin:0;font-family:var(--serif);font-size:17px;letter-spacing:.08em;white-space:nowrap}
    .brand a{color:inherit;text-decoration:none}
    .brand small{display:none}
    aside nav{display:flex;gap:3px;min-width:0;overflow:auto;scrollbar-width:none}
    aside nav::-webkit-scrollbar{display:none}
    nav a{flex:0 0 auto;padding:7px 10px;border:0;border-radius:999px;font:12px/1.2 var(--serif);color:var(--muted)}
    nav a:hover,nav a.active{color:var(--forest);border:0;background:var(--forest-soft)}
    .tools{margin:0;display:flex;flex-wrap:nowrap}
    .tools button{font-family:var(--serif);background:transparent;border-color:var(--line);color:var(--ink)}
    main{border:1px solid var(--line);border-top:2px solid var(--ink);background:var(--paper);overflow:hidden}
    .mobile-nav{display:none!important}
    .hero{
      min-height:610px;margin:0;padding:54px 68px 62px;border:0;box-shadow:none;color:#f8f5ec;
      background:
        linear-gradient(135deg,rgba(255,255,255,.055) 0 1px,transparent 1px 100%),
        radial-gradient(circle at 84% 10%,rgba(223,183,97,.22),transparent 28%),
        linear-gradient(145deg,#181411,#28211c 62%,#342820);
      background-size:31px 31px,auto,auto;
    }
    .hero:before{width:370px;height:370px;right:-140px;top:-145px;border:1px solid rgba(255,255,255,.14);background:none}
    .hero:after{content:"";position:absolute;width:170px;height:170px;right:82px;top:92px;border:1px solid rgba(255,255,255,.14);border-radius:50%;box-shadow:0 0 0 44px rgba(255,255,255,.03),0 0 0 88px rgba(255,255,255,.018)}
    .eyebrow{position:relative;z-index:2;display:flex;align-items:center;gap:12px;margin:48px 0 62px;color:#e4c66e;font:700 12px/1.2 var(--mono);letter-spacing:.18em}
    .eyebrow:before{content:"";width:36px;height:1px;background:currentColor}
    h1{position:relative;z-index:2;max-width:760px;margin:0;font-family:var(--serif);font-size:clamp(48px,7.2vw,76px);font-weight:650;line-height:1.12;letter-spacing:-.05em}
    .hero h1 em{color:#e5c36c;font-style:normal}
    .deck{position:relative;z-index:2;max-width:690px;margin:31px 0 0;color:rgba(248,245,236,.76);font-family:var(--serif);font-size:20px;line-height:1.76}
    .meta{position:relative;z-index:2;margin-top:36px;color:rgba(248,245,236,.5);font:11px/1.5 var(--mono);letter-spacing:.04em}
    .architecture-gateway{padding:48px 40px 32px;border-bottom:1px solid var(--line);background:var(--paper-soft)}
    .gateway-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-bottom:24px}
    .gateway-head b{display:block;font-size:23px;color:var(--forest)}
    .gateway-head span{max-width:410px;color:var(--muted);font-size:13px;text-align:right}
    .gateway-kicker{display:block;margin-bottom:12px;color:var(--clay);font:10px/1.3 var(--mono);letter-spacing:.13em}
    .axis-map{display:grid;grid-template-columns:1fr 76px 1fr 76px 1fr;align-items:stretch}
    .axis-node{min-height:142px;padding:18px;border:1px solid var(--line);background:var(--paper);display:flex;flex-direction:column;justify-content:space-between}
    .axis-node.sequence{border-top:4px solid var(--blue)}.axis-node.depth{border-top:4px solid var(--gold)}.axis-node.width{border-top:4px solid var(--clay)}
    .axis-node small{font:10px/1.2 var(--mono);letter-spacing:.14em;color:var(--soft);text-transform:uppercase}
    .axis-node b{font-size:19px}.axis-node span{color:var(--muted);font-size:13px;line-height:1.55}
    .axis-link{display:grid;place-items:center;position:relative;color:var(--forest);font:700 12px/1 var(--mono)}
    .axis-link:before{content:"";position:absolute;left:10px;right:10px;top:50%;height:1px;background:var(--line-strong)}
    .axis-link i{z-index:1;padding:6px;background:var(--paper-soft);font-style:normal}
    .stats{margin:0;padding:24px 40px 30px;border-bottom:1px solid var(--line);background:var(--paper);grid-template-columns:repeat(4,1fr)}
    .stat{border:0;border-left:1px solid var(--line);background:transparent;padding:8px 18px}
    .stat:first-child{border-left:0}.stat b{font-family:var(--serif);font-size:31px;color:var(--clay)}.stat span{font-family:var(--serif)}
    article>section{margin:0;padding:74px 68px 42px;border-top:1px solid var(--line);position:relative}
    article>section:before{
      content:attr(data-mark);display:grid;width:35px;height:35px;margin-bottom:18px;
      place-items:center;border:1px solid color-mix(in srgb,var(--clay) 55%,transparent);border-radius:50%;
      color:var(--clay);font-size:14px;
    }
    article>section:first-child{border-top:0}
    h2{max-width:760px;margin:0 0 30px;padding:0;color:var(--forest);font-family:var(--serif);font-size:clamp(32px,4.5vw,44px);font-weight:650;line-height:1.26;letter-spacing:-.035em}
    h3{margin:48px 0 17px;color:var(--ink);font-family:var(--serif);font-size:25px;line-height:1.4}
    h4{font-family:var(--serif);font-size:19px}
    p{margin:0 0 22px}.lead{font-family:var(--serif);font-size:21px;line-height:1.92;color:var(--ink)}
    .lead:first-letter{float:left;margin:12px 9px 0 0;color:var(--clay);font-size:59px;font-weight:700;line-height:.72}
    strong{color:var(--forest)}
    .card,.note,.truth,.explain,.caution{border-radius:0;box-shadow:none;background:var(--paper-soft);padding:24px 26px}
    .truth{border-left:4px solid var(--forest);background:var(--forest-soft)}.explain{border-left:4px solid var(--gold);background:var(--gold-soft)}
    .caution{border-left:4px solid var(--clay);background:var(--clay-soft)}.note{border-left:4px solid var(--blue);background:var(--blue-soft)}
    .label{font-family:var(--mono);font-size:10px}
    .grid2,.grid3{gap:0;border:1px solid var(--line)}
    .mini{border:0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:transparent;padding:22px}
    .grid2 .mini:nth-child(2n),.grid3 .mini:nth-child(3n){border-right:0}
    .mini h4{color:var(--forest)}
    .flow{gap:0;border:1px solid var(--line);background:var(--paper-soft)}
    .flow .step{border:0;border-right:1px solid var(--line);background:transparent;min-height:105px;padding:17px}
    .flow .step:last-child{border-right:0}.flow .step:not(:last-child):after{right:-8px;color:var(--clay);background:var(--paper-soft);line-height:1}
    .formula{border-radius:0;border-left:4px solid var(--gold);background:#1b211e;color:#eff4ee;box-shadow:none}
    details{border-radius:0;background:var(--paper);border-color:var(--line)}summary{color:var(--forest)}
    .table-wrap{border-radius:0;background:var(--paper)}thead th{background:var(--forest-soft)}th:first-child,td:first-child{background:var(--paper)}
    .quote{font-family:var(--serif);color:var(--forest);border-color:var(--clay)}
    footer{margin:42px -68px -42px;padding:34px 68px 44px;background:#1f3834;color:#d6ddd8;border:0}

    .visual-block{margin:40px 0;padding:28px;border:1px solid var(--line);background:var(--paper-soft);overflow:hidden}
    .visual-head{display:flex;justify-content:space-between;gap:22px;align-items:flex-start;margin-bottom:26px}
    .visual-head h4{margin:0;color:var(--forest);font-size:23px}.visual-head p{max-width:390px;margin:0;text-align:right;color:var(--muted);font-size:13px;line-height:1.6}
    .hybrid-lane{display:grid;grid-template-columns:repeat(8,1fr);gap:7px;align-items:end}
    .hybrid-lane div{display:grid;place-items:center;min-height:92px;padding:8px;border:1px solid var(--line);background:var(--paper)}
    .hybrid-lane div:nth-child(4n){min-height:132px;color:#eef5f1;background:var(--forest);border-color:var(--forest)}
    .hybrid-lane b{font-size:14px}.hybrid-lane small{font:9px/1.2 var(--mono);letter-spacing:.1em;color:inherit;opacity:.72}
    .hybrid-caption{display:grid;grid-template-columns:3fr 1fr;margin-top:12px;font-size:12px;color:var(--muted)}
    .hybrid-caption span{padding:8px 12px;border-top:2px solid var(--blue)}.hybrid-caption span:last-child{border-color:var(--forest)}
    .attnres-map{display:grid;grid-template-columns:1fr 86px 1.2fr;align-items:center;gap:14px}
